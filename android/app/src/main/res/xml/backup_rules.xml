<?xml version="1.0" encoding="utf-8"?>
<!-- Data absensi tinggal di Firestore, bukan di cadangan Google, supaya
     pemulihan tablet tidak pernah menghidupkan kembali absen basi. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
