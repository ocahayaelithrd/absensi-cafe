rules_version = '2';

/* Cloud Storage tidak dipakai aplikasi ini.

   Foto bukti absen tertanam langsung di dokumen absen sebagai data URL JPEG
   kecil, bukan berkas terpisah. Alasannya luring: penulisan Firestore
   mengantre sendiri saat internet cafe mati, sementara unggahan Storage tidak
   punya antrean — dengan menanam fotonya, absen berikut buktinya tersimpan
   dalam satu penulisan yang pasti terkirim begitu jaringan hidup.

   Bucket-nya tetap ada di proyek, jadi aksesnya ditutup penuh di sini supaya
   tidak menganga dengan aturan bawaan. */

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
