rules_version = '2';

/* Aturan akses Absensi Cafe.

   Seluruh data cafe bersarang di bawah satu dokumen `cafe/main`, warisan
   aplikasi versi lama yang mencerminkan satu tablet ke awan. Bentuknya
   dipertahankan supaya data yang sudah ada tetap terbaca.

   Dua peran, disimpan di dokumen `users/{uid}` yang hanya bisa dibuat lewat
   console Firebase. Pendaftaran mandiri dimatikan di console, jadi tidak ada
   cara membuat akun baru dari luar.

   - kiosk  : tablet di kasir. Boleh membaca data acuan dan menulis absen,
              tapi tidak boleh mengubah karyawan, shift, jadwal, atau
              pengaturan — supaya tablet yang dicuri tidak bisa dipakai
              menaikkan gaji.
   - admin  : PC admin lewat web. Boleh semuanya, termasuk menghapus. */

service cloud.firestore {
  match /databases/{database}/documents {

    function akun() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function masuk() {
      return request.auth != null
          && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function admin() {
      return masuk() && akun().role == 'admin';
    }
    function kiosk() {
      return masuk() && akun().role == 'kiosk';
    }

    /* Peran hanya boleh dilihat pemiliknya sendiri dan diubah lewat console. */
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /cafe/{cafeId} {

      /* Dokumen induk memuat pengaturan: dibaca kios, ditulis admin. */
      allow read: if masuk();
      allow write: if admin();

      match /employees/{id} {
        allow read: if masuk();
        allow write: if admin();
      }
      match /shifts/{id} {
        allow read: if masuk();
        allow write: if admin();
      }
      match /roster/{tanggal} {
        allow read: if masuk();
        allow write: if admin();
      }

      /* Absen: kios mencatat, admin mengoreksi, hanya admin yang boleh hapus.

         Kios tidak boleh memindahkan sebuah catatan ke karyawan atau tanggal
         lain, dan tidak boleh menyentuh catatan yang absen pulangnya sudah
         tercatat — sekali sebuah hari selesai, hanya admin yang boleh
         mengubahnya. Foto ikut dalam penulisan yang sama, jadi tablet memang
         tidak pernah perlu menyunting catatan yang sudah lengkap. */
      match /records/{id} {
        function tetap(field) {
          return request.resource.data[field] == resource.data[field];
        }
        allow read: if masuk();
        allow create: if (kiosk() || admin())
                      && request.resource.data.empId is string
                      && request.resource.data.date is string;
        allow update: if admin()
                      || (kiosk() && tetap('empId') && tetap('date')
                          && resource.data.outAt == null);
        allow delete: if admin();
      }

      /* Catatan tablet yang pernah tersambung, dipakai admin untuk melihat
         kios mana yang masih hidup. */
      match /devices/{id} {
        allow read: if masuk();
        allow create, update: if kiosk() || admin();
        allow delete: if admin();
      }

      /* Kotak koreksi milik aplikasi versi lama. Tidak dipakai lagi — koreksi
         sekarang ditulis admin langsung ke catatannya. Ditutup untuk kios agar
         dokumen sisa tidak bisa dipakai menyuntikkan perubahan. */
      match /koreksi/{id} {
        allow read, write: if admin();
      }

      match /{sisa=**} {
        allow read: if masuk();
        allow write: if admin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
